APP_NAME=Upvane
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upvane
DB_USERNAME=upvane
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Upvane ---
# Resend REST API (https://resend.com) — used for all outbound email (transactional + incident alerts).
RESEND_API_KEY=
RESEND_FROM="Upvane <alerts@upvane.app>"
# Single-vantage-point region label for this deployment (shared hosting = one server = one region).
DEFAULT_MONITOR_REGION=local
# How long raw check_results rows are kept before being pruned by maintenance:run (dashboards read rollups, not raw rows).
CHECK_RETENTION_HOURS=48
# Dev-only SSRF guard bypass. Must never be true in production (enforced in code regardless of this flag when APP_ENV=production).
UPVANE_ALLOW_PRIVATE_TARGETS=false
# Guards GET /deploy?token=...&action=migrate|optimize|optimize-clear — the no-SSH-hosting
# stand-in for running artisan by hand. Generate a long random value; leave blank to disable
# the route entirely (it 404s rather than allowing unauthenticated access).
DEPLOY_TOKEN=
